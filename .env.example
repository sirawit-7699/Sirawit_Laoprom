# Copy to .env and set the server connection, or point to your existing .env.
WEATHER_ENV_FILE=D:/testpython/tmd_flask_app/.env
DB_NAME=weather_db
TMD_COLLECTION=tmd_weather
SENSOR_COLLECTION=sensor_data
LOCAL_MONGO_URI=mongodb://localhost:27017/
# Required for the hourly collector; get this from Atlas > Connect > Drivers.
# ATLAS_MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER/?retryWrites=true&w=majority
TMD_PROVINCE=สกลนคร
TMD_AMPHOE=เมืองสกลนคร
TMD_TAMBON=เชียงเครือ
# For an explicit offline preview only (leave unset to use MongoDB):
# WEATHER_SAMPLE_FILE=D:/testpython/tmd_flask_app/weather_db.tmd_weather.json
