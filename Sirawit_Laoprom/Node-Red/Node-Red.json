    {
        "id": "d08394e1eb510be0",
        "type": "function",
        "z": "b1a28128df7d43f7",
        "name": "Collect Hourly Data",
        "func": "let data = msg.payload;\n\nlet samples = flow.get(\"hourlySamples\") || [];\n\nsamples.push({\n    temperature: data.temperature,\n    humidity: data.humidity,\n    pressure: data.pressure,\n    mq135: data.mq135,\n    lux: data.lux,\n    wind_speed: data.wind_speed,\n    receivedAt: Date.now()\n});\n\n// กันข้อมูลสะสมผิดปกติ\n// ถ้าส่งทุก 1 นาที ปกติไม่ควรเกินประมาณ 60 ค่า/ชั่วโมง\nif (samples.length > 1000) {\n    samples.shift();\n}\n\nflow.set(\"hourlySamples\", samples);\n\nreturn null;",
