    {
        "id": "65f8015948ec826f",
        "type": "function",
        "z": "b1a28128df7d43f7",
        "name": "Calculate Hourly Average",
        "func": "let samples = flow.get(\"hourlySamples\") || [];\n\nif (samples.length === 0) {\n    node.warn(\"ไม่มีข้อมูล Sensor สำหรับคำนวณค่าเฉลี่ย\");\n    return null;\n}\n\nfunction average(field) {\n    let values = samples\n        .map(s => Number(s[field]))\n        .filter(v => Number.isFinite(v));\n\n    if (values.length === 0) {\n        return null;\n    }\n\n    let sum = values.reduce((a, b) => a + b, 0);\n\n    return sum / values.length;\n}\n\nlet avgData = {\n    temperature: average(\"temperature\"),\n    humidity: average(\"humidity\"),\n    pressure: average(\"pressure\"),\n    mq135: average(\"mq135\"),\n    lux: average(\"lux\"),\n    wind_speed: average(\"wind_speed\"),\n\n    sample_count: samples.length\n};\n\n// ล้างค่าเก่า เพื่อเริ่มสะสมชั่วโมงใหม่\nflow.set(\"hourlySamples\", []);\n\nmsg.payload = avgData;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 440,
