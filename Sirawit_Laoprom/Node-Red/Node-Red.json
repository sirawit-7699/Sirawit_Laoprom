    {
        "id": "0c584df821af4753",
        "type": "function",
        "z": "b1a28128df7d43f7",
        "name": "Prepare MongoDB",
        "func": "let data = msg.payload;\n\n// ตอน 14:00 เรากำลังบันทึกค่าเฉลี่ยของช่วง 13:00-13:59\nlet hourTime = new Date();\nhourTime.setMinutes(0, 0, 0);\nhourTime.setHours(hourTime.getHours() - 1);\n\nlet filter = {\n    station_id: \"station01\",\n    timestamp: hourTime\n};\n\nlet update = {\n    $set: {\n        temperature: data.temperature,\n        humidity: data.humidity,\n        pressure: data.pressure,\n        ppm: data.mq135 ?? null,\n        lux: data.lux,\n        wind_speed: data.wind_speed ?? null\n    }\n};\n\nlet options = {\n    upsert: true\n};\n\nmsg.payload = [\n    filter,\n    update,\n    options\n];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 710,
